+}
+
+function createMemoryStorage(entries = {}) {
+  const values = new Map(Object.entries(entries));
+  return {
+    async getItem(key) {
+      return values.get(key) ?? null;
+    },
+    async setItem(key, value) {
+      values.set(key, value);
+    },
+    value(key) {
+      return values.get(key) ?? null;
+    },
+  };
+}
